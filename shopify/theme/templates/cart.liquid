<div class="wwc-util">
  <h1>Cart</h1>
  {% form 'cart', cart %}
    {% for item in cart.items %}
      <p>{{ item.quantity }} × {{ item.product.title }} — {{ item.line_price | money }}</p>
    {% endfor %}
    <p>Total: {{ cart.total_price | money }}</p>
    <button type="submit" name="checkout">Checkout</button>
  {% endform %}
</div>
