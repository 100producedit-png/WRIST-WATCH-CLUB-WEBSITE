<div class="wwc-util">
  <h1>Reset password</h1>
  {% form 'reset_customer_password' %}
    <input type="password" name="customer[password]" placeholder="New password" />
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" />
    <button type="submit">Reset</button>
  {% endform %}
</div>
