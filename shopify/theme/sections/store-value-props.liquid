{%- comment -%}
  Slim value-props strip (shipping / warranty / returns), nixon.com-style.
{%- endcomment -%}

<section class="st-props">
  <div class="st-wrap">
    <div class="st-props__row" style="--st-props-cols: {{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <div class="st-prop" {{ block.shopify_attributes }}>
          <p class="st-prop__title">{{ block.settings.title }}</p>
          <p class="st-prop__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "settings": [],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "prop", "settings": { "title": "Free shipping", "text": "On all orders over $50" } },
        { "type": "prop", "settings": { "title": "2-year warranty", "text": "On every watch we make" } },
        { "type": "prop", "settings": { "title": "30-day returns", "text": "No questions asked" } },
        { "type": "prop", "settings": { "title": "Secure checkout", "text": "Powered by Shopify" } }
      ]
    }
  ]
}
{% endschema %}
