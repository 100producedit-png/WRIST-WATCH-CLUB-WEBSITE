{% comment %}
  Credit / financing application. Submits through Shopify's contact form,
  so every application arrives in the store's email inbox (Settings →
  Notifications → the "Sender email"). No apps required.

  Deliberately does NOT ask for SSN, date of birth, or account numbers —
  a storefront form is the wrong place for those. Identity verification
  belongs with your financing partner's secure portal.
{% endcomment %}

{% style %}
  /* Self-contained styles so this section works on any theme,
     not just the WWC custom theme. Variables fall back to the
     WWC palette when the host theme doesn't define them. */
  .wwc-app-scope { background: #08080a; color: #ece7dd; font-family: 'Inter','Helvetica Neue',sans-serif; font-weight: 300; }
  .wwc-app-scope .wwc-shell--form { max-width: 52rem; margin: 0 auto; padding: 5rem 1.5rem 7rem; }
  .wwc-app-scope .wwc-center { text-align: center; }
  .wwc-app-scope .wwc-overline { font-size: .62rem; letter-spacing: .5em; text-indent: .5em; color: #c9a35c; text-transform: uppercase; }
  .wwc-app-scope .wwc-title { font-family: 'Cormorant Garamond','Times New Roman',serif; font-weight: 500; color: #ece7dd; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.1; margin: 1rem 0 1.6rem; }
  .wwc-app-scope .wwc-form__intro { color: rgba(236,231,221,.55); line-height: 1.8; font-size: .95rem; max-width: 34rem; margin: 0 auto 3rem; }
  .wwc-app-scope .wwc-fieldset { border: 1px solid rgba(236,231,221,.08); padding: 1.8rem 1.6rem 2rem; margin: 0 0 2rem; }
  .wwc-app-scope .wwc-fieldset legend { font-size: .62rem; letter-spacing: .42em; text-transform: uppercase; color: #c9a35c; padding: 0 .8rem; }
  .wwc-app-scope .wwc-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem 1.6rem; }
  .wwc-app-scope .wwc-field { display: flex; flex-direction: column; gap: .45rem; }
  .wwc-app-scope .wwc-field--wide { grid-column: 1 / -1; }
  .wwc-app-scope .wwc-field > span { font-size: .6rem; letter-spacing: .28em; text-transform: uppercase; color: rgba(236,231,221,.55); }
  .wwc-app-scope .wwc-input { font: inherit; font-size: .85rem; color: #ece7dd; background: transparent; border: 1px solid rgba(201,163,92,.28); padding: .95rem 1.2rem; letter-spacing: .05em; width: 100%; box-sizing: border-box; border-radius: 0; }
  .wwc-app-scope .wwc-input:focus { outline: none; border-color: #c9a35c; }
  .wwc-app-scope select.wwc-input option { background: #08080a; }
  .wwc-app-scope textarea.wwc-input { resize: vertical; }
  .wwc-app-scope .wwc-form__consent { margin: 2.4rem 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .wwc-app-scope .wwc-check { display: flex; gap: .9rem; align-items: flex-start; font-size: .8rem; line-height: 1.7; color: rgba(236,231,221,.55); cursor: pointer; }
  .wwc-app-scope .wwc-check input { margin-top: .35rem; accent-color: #c9a35c; }
  .wwc-app-scope .wwc-check strong { color: #ece7dd; font-weight: 400; }
  .wwc-app-scope .wwc-btn { display: inline-block; background: #c9a35c; color: #0a0a0a; border: 0; cursor: pointer; font-size: .62rem; letter-spacing: .28em; text-transform: uppercase; padding: 1.05rem 2.2rem; min-width: 18rem; transition: background .3s ease; border-radius: 0; }
  .wwc-app-scope .wwc-btn:hover { background: #e3c07e; }
  .wwc-app-scope .wwc-form__small { font-size: .68rem; color: rgba(236,231,221,.55); letter-spacing: .06em; margin-top: 1.2rem; }
  .wwc-app-scope .wwc-form__error { border: 1px solid rgba(201,92,92,.5); color: #d99; padding: 1rem 1.3rem; font-size: .85rem; margin-bottom: 2rem; }
  .wwc-app-scope .wwc-schumer { border: 2px solid rgba(201,163,92,.6); margin: 3rem 0 2.4rem; }
  .wwc-app-scope .wwc-schumer__title { font-family: 'Cormorant Garamond','Times New Roman',serif; font-weight: 500; font-size: 1.4rem; color: #ece7dd; margin: 0; padding: 1.3rem 1.5rem; border-bottom: 2px solid rgba(201,163,92,.6); }
  .wwc-app-scope .wwc-schumer__table { width: 100%; border-collapse: collapse; }
  .wwc-app-scope .wwc-schumer__table th, .wwc-app-scope .wwc-schumer__table td { border-bottom: 1px solid rgba(236,231,221,.12); padding: 1.1rem 1.5rem; vertical-align: top; text-align: left; }
  .wwc-app-scope .wwc-schumer__table tr:last-child th, .wwc-app-scope .wwc-schumer__table tr:last-child td { border-bottom: 0; }
  .wwc-app-scope .wwc-schumer__table th { width: 38%; font-weight: 400; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: #c9a35c; }
  .wwc-app-scope .wwc-schumer__table td { font-size: .85rem; line-height: 1.7; color: rgba(236,231,221,.8); }
  .wwc-app-scope .wwc-schumer__table td p { margin: 0 0 .6em; } .wwc-app-scope .wwc-schumer__table td p:last-child { margin-bottom: 0; }
  .wwc-app-scope .wwc-schumer__note { padding: 1rem 1.5rem; border-top: 1px solid rgba(236,231,221,.12); font-size: .72rem; line-height: 1.7; color: rgba(236,231,221,.55); margin: 0; }
  @media (max-width: 640px) {
    .wwc-app-scope .wwc-schumer__table th, .wwc-app-scope .wwc-schumer__table td { display: block; width: auto; }
    .wwc-app-scope .wwc-schumer__table th { border-bottom: 0; padding-bottom: .2rem; }
  }
  .wwc-app-scope .wwc-form__success { text-align: center; border: 1px solid rgba(201,163,92,.28); padding: 4rem 2rem; font-family: 'Cormorant Garamond','Times New Roman',serif; font-size: 1.3rem; color: #ece7dd; }
  @media (max-width: 640px) {
    .wwc-app-scope .wwc-form__grid { grid-template-columns: 1fr; }
    .wwc-app-scope .wwc-btn { width: 100%; min-width: 0; }
  }
{% endstyle %}

<div class="wwc-app-scope">
<div class="wwc-shell wwc-shell--form">
  <div class="wwc-center">
    <p class="wwc-overline">{{ section.settings.overline | escape }}</p>
    <h1 class="wwc-title">{{ section.settings.title | escape }}</h1>
    <p class="wwc-prose wwc-form__intro">{{ section.settings.intro | escape }}</p>
  </div>

  {% form 'contact', class: 'wwc-appform' %}
    {% if form.posted_successfully? %}
      <div class="wwc-form__success" aria-live="polite">
        <p class="wwc-overline">RECEIVED</p>
        <p>{{ section.settings.confirm | escape }}</p>
      </div>
    {% else %}

      {% if form.errors %}
        <p class="wwc-form__error" role="alert">
          Please review the form — a required field is missing or invalid.
        </p>
      {% endif %}

      <input type="hidden" name="contact[form_type_label]" value="Credit application" />

      <fieldset class="wwc-fieldset">
        <legend>Applicant</legend>
        <div class="wwc-form__grid">
          <label class="wwc-field">
            <span>First name</span>
            <input class="wwc-input" type="text" name="contact[first_name]" autocomplete="given-name" required />
          </label>
          <label class="wwc-field">
            <span>Last name</span>
            <input class="wwc-input" type="text" name="contact[last_name]" autocomplete="family-name" required />
          </label>
          <label class="wwc-field">
            <span>Email</span>
            <input class="wwc-input" type="email" name="contact[email]" autocomplete="email" required />
          </label>
          <label class="wwc-field">
            <span>Phone</span>
            <input class="wwc-input" type="tel" name="contact[phone]" autocomplete="tel" required />
          </label>
        </div>
      </fieldset>

      <fieldset class="wwc-fieldset">
        <legend>Residence</legend>
        <div class="wwc-form__grid">
          <label class="wwc-field wwc-field--wide">
            <span>Street address</span>
            <input class="wwc-input" type="text" name="contact[street_address]" autocomplete="street-address" required />
          </label>
          <label class="wwc-field">
            <span>City</span>
            <input class="wwc-input" type="text" name="contact[city]" autocomplete="address-level2" required />
          </label>
          <label class="wwc-field">
            <span>State / Province</span>
            <input class="wwc-input" type="text" name="contact[state]" autocomplete="address-level1" required />
          </label>
          <label class="wwc-field">
            <span>ZIP / Postal code</span>
            <input class="wwc-input" type="text" name="contact[zip]" autocomplete="postal-code" required />
          </label>
          <label class="wwc-field">
            <span>Country</span>
            <input class="wwc-input" type="text" name="contact[country]" autocomplete="country-name" required />
          </label>
          <label class="wwc-field">
            <span>Housing</span>
            <select class="wwc-input" name="contact[housing_status]" required>
              <option value="" disabled selected>Select…</option>
              <option>Own</option>
              <option>Rent</option>
              <option>Other</option>
            </select>
          </label>
          <label class="wwc-field">
            <span>Monthly housing payment (USD)</span>
            <input class="wwc-input" type="number" name="contact[monthly_housing_payment]" min="0" step="1" inputmode="numeric" />
          </label>
        </div>
      </fieldset>

      <fieldset class="wwc-fieldset">
        <legend>Employment &amp; income</legend>
        <div class="wwc-form__grid">
          <label class="wwc-field">
            <span>Employment status</span>
            <select class="wwc-input" name="contact[employment_status]" required>
              <option value="" disabled selected>Select…</option>
              <option>Employed</option>
              <option>Self-employed</option>
              <option>Business owner</option>
              <option>Retired</option>
              <option>Other</option>
            </select>
          </label>
          <label class="wwc-field">
            <span>Employer / Company</span>
            <input class="wwc-input" type="text" name="contact[employer]" autocomplete="organization" />
          </label>
          <label class="wwc-field">
            <span>Occupation / Title</span>
            <input class="wwc-input" type="text" name="contact[occupation]" autocomplete="organization-title" />
          </label>
          <label class="wwc-field">
            <span>Years with employer</span>
            <input class="wwc-input" type="number" name="contact[years_employed]" min="0" max="60" step="1" inputmode="numeric" />
          </label>
          <label class="wwc-field wwc-field--wide">
            <span>Annual income (USD)</span>
            <select class="wwc-input" name="contact[annual_income]" required>
              <option value="" disabled selected>Select…</option>
              <option>Under $100,000</option>
              <option>$100,000 – $250,000</option>
              <option>$250,000 – $500,000</option>
              <option>$500,000 – $1,000,000</option>
              <option>Over $1,000,000</option>
            </select>
          </label>
        </div>
      </fieldset>

      <div class="wwc-form__consent">
        <label class="wwc-check">
          <input type="checkbox" name="contact[certified_accurate]" value="Yes" required />
          <span>I certify the information above is accurate, and I authorize
          {{ section.settings.legal_name | default: shop.name | escape }} to contact me about this application.</span>
        </label>
        <label class="wwc-check">
          <input type="checkbox" name="contact[credit_review_consent]" value="Yes" required />
          <span>I understand this is a pre-qualification enquiry, not a loan offer.
          Formal credit review — including identity verification — is completed
          separately through a secure portal with our financing partner.
          <strong>Never include your SSN or account numbers in this form.</strong></span>
        </label>
      </div>

      {%- liquid
        assign schumer_rows = section.blocks | where: 'type', 'schumer_row'
        assign schumer_acks = section.blocks | where: 'type', 'acknowledgment'
      -%}
      {% if schumer_rows.size > 0 %}
        <div class="wwc-schumer">
          <h2 class="wwc-schumer__title">{{ section.settings.schumer_heading | escape }}</h2>
          <table class="wwc-schumer__table">
            {% for block in schumer_rows %}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.term | escape }}</th>
                <td>{{ block.settings.value }}</td>
              </tr>
            {% endfor %}
          </table>
          {% if section.settings.schumer_note != blank %}
            <p class="wwc-schumer__note">{{ section.settings.schumer_note | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if schumer_acks.size > 0 %}
        <div class="wwc-form__consent">
          {% for block in schumer_acks %}
            <label class="wwc-check" {{ block.shopify_attributes }}>
              <input type="checkbox" name="contact[terms_acknowledgment_{{ forloop.index }}]" value="Yes" required />
              <span>{{ block.settings.text }}</span>
            </label>
          {% endfor %}
        </div>
      {% endif %}

      <div class="wwc-center">
        <button type="submit" class="wwc-btn wwc-form__submit">{{ section.settings.button_label | escape }}</button>
        <p class="wwc-form__small">{{ section.settings.smallprint | escape }}</p>
      </div>

    {% endif %}
  {% endform %}
</div>
</div>

{% schema %}
{
  "name": "Credit application",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "PRIVATE CLIENT FINANCING" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Credit Application" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Own the Eclipse on your terms. Complete the application below — our private client desk reviews every enquiry personally and responds within two business days." },
    { "type": "text", "id": "legal_name", "label": "Legal business name (consent line)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit application" },
    { "type": "text", "id": "confirm", "label": "Confirmation message", "default": "Your application is with our private client desk. Expect a reply within two business days." },
    { "type": "text", "id": "smallprint", "label": "Small print", "default": "Submitting does not obligate you to purchase, and does not affect your credit score." },
    { "type": "header", "content": "Schumer box (credit terms disclosure)" },
    { "type": "text", "id": "schumer_heading", "label": "Schumer box heading", "default": "Interest Rates and Interest Charges" },
    { "type": "textarea", "id": "schumer_note", "label": "Schumer box footnote (optional)" }
  ],
  "blocks": [
    {
      "type": "schumer_row",
      "name": "Schumer box row",
      "settings": [
        { "type": "text", "id": "term", "label": "Term (left column)", "default": "Annual Percentage Rate (APR)" },
        { "type": "richtext", "id": "value", "label": "Disclosure text (right column)", "default": "<p>[Add your disclosure text here]</p>" }
      ]
    },
    {
      "type": "acknowledgment",
      "name": "Acknowledgment checkbox",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Acknowledgment text", "default": "<p>I acknowledge that I have read and received the credit terms disclosure above.</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Credit application" }]
}
{% endschema %}
