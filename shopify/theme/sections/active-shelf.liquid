{{ 'active.css' | asset_url | stylesheet_tag }}
<script src="{{ 'active.js' | asset_url }}" defer></script>

{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
  assign limit = section.settings.max_products
-%}

<section class="a-section a-shelf" data-rail>
  <div class="a-wrap a-shelf__head">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="a-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="a-h a-shelf__title">{{ section.settings.title | escape }}</h2>
    </div>
    <div class="a-shelf__nav">
      {%- if section.settings.cta_label != blank -%}
        <a class="a-arrowlink" href="{{ section.settings.cta_link | default: col.url }}" style="margin-right:1rem;">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      <button class="a-shelf__btn" type="button" data-rail-prev aria-label="Previous">←</button>
      <button class="a-shelf__btn" type="button" data-rail-next aria-label="Next">→</button>
    </div>
  </div>

  <div class="a-rail">
    {%- if col.products.size > 0 -%}
      {%- for product in col.products limit: limit -%}
        {% render 'active-product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..5) -%}
        <a class="a-pcard" href="{{ routes.all_products_collection_url }}">
          <div class="a-pcard__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <h3 class="a-pcard__title">Example product {{ i }}</h3>
          <p class="a-pcard__price">$0</p>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Active — Product shelf",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "MOST WANTED" },
    { "type": "text", "id": "title", "label": "Title", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "cta_label", "label": "View-all label", "default": "Shop all" },
    { "type": "url", "id": "cta_link", "label": "View-all link" }
  ],
  "presets": [{ "name": "Active — Product shelf" }]
}
{% endschema %}
