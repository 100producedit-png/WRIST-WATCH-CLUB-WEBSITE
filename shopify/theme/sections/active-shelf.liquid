{{ 'active.css' | asset_url | stylesheet_tag }}
<script src="{{ 'active.js' | asset_url }}" defer></script>

{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
  assign limit = section.settings.max_products
-%}

<section class="a-section a-shelf" data-rail>
  <div class="a-wrap a-shelf__head">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="a-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="a-h a-shelf__title">{{ section.settings.title | escape }}</h2>
    </div>
    <div class="a-shelf__nav">
      {%- if section.settings.cta_label != blank -%}
        <a class="a-arrowlink" href="{{ section.settings.cta_link | default: col.url }}" style="margin-right:1rem;">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      <button class="a-shelf__btn" type="button" data-rail-prev aria-label="Previous">←</button>
      <button class="a-shelf__btn" type="button" data-rail-next aria-label="Next">→</button>
    </div>
  </div>

  <div class="a-rail">
    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Hand-picked mode: blocks replace the collection feed. Each block picks
        a product and can override its image, hover image and link.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          <span {{ block.shopify_attributes }}>
            {%- render 'active-product-card',
              product: block.settings.product,
              custom_image: block.settings.image,
              custom_hover: block.settings.hover_image,
              custom_link: block.settings.link
            -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.fill_from_collection -%}
        {%- for product in col.products limit: limit -%}
          {%- assign picked = false -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product.id == product.id -%}{%- assign picked = true -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- unless picked -%}
            {% render 'active-product-card', product: product %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- elsif col.products.size > 0 -%}
      {%- for product in col.products limit: limit -%}
        {% render 'active-product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..5) -%}
        <a class="a-pcard" href="{{ routes.all_products_collection_url }}">
          <div class="a-pcard__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <h3 class="a-pcard__title">Example product {{ i }}</h3>
          <p class="a-pcard__price">$0</p>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Active — Product shelf",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "MOST WANTED" },
    { "type": "text", "id": "title", "label": "Title", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products. Ignored while product blocks are added, unless \"Fill remaining slots\" is on." },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "fill_from_collection", "label": "Fill remaining slots from collection", "info": "When using product blocks, append the rest of the collection after them.", "default": false },
    { "type": "text", "id": "cta_label", "label": "View-all label", "default": "Shop all" },
    { "type": "url", "id": "cta_link", "label": "View-all link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Replaces the product's featured image on this card." },
        { "type": "image_picker", "id": "hover_image", "label": "Hover image override", "info": "Shown on hover. Leave empty for no hover swap when an image override is set." },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "Active — Product shelf" }]
}
{% endschema %}
