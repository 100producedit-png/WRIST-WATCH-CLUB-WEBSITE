{{ 'active.css' | asset_url | stylesheet_tag }}
<script src="{{ 'active.js' | asset_url }}" defer></script>

<section class="a-section a-news">
  <div class="a-wrap">
    {%- if section.settings.kicker != blank -%}<p class="a-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    <h2 class="a-h a-news__title">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <p class="a-sub a-news__sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- form 'customer', class: 'a-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter" />
      <input class="a-news__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Enter your email' | escape }}" required aria-label="Email" />
      <button class="a-btn" type="submit">{{ section.settings.button_label | default: 'Sign up' | escape }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Active — Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "10% OFF YOUR FIRST ORDER" },
    { "type": "text", "id": "title", "label": "Title", "default": "Get on the list" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Drops, deals and stories. No spam, ever." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
  ],
  "presets": [{ "name": "Active — Newsletter" }]
}
{% endschema %}
