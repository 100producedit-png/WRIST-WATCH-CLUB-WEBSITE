{%- comment -%}
  Full-bleed homepage hero. Media priority: Shopify-hosted video → external
  video URL → picked image → fallback image URL, so the section never renders
  empty. Video autoplays muted, loops, and uses the image as its poster.
{%- endcomment -%}

{%- liquid
  assign poster = section.settings.fallback_url
  if section.settings.image
    assign poster = section.settings.image | image_url: width: 2400
  endif
-%}

<section class="st-hero{% if section.settings.height == 'short' %} st-hero--short{% endif %}">
  <div class="st-hero__media">
    {%- if section.settings.video != null -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '2400x' }}
    {%- elsif section.settings.video_url != blank -%}
      <video autoplay loop muted playsinline preload="metadata"
             {% if poster != blank %}poster="{{ poster }}"{% endif %}
             aria-hidden="true" tabindex="-1">
        <source src="{{ section.settings.video_url }}" type="video/mp4" />
      </video>
    {%- elsif section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw" alt="{{ section.settings.image.alt | escape }}" width="2400" height="1350" fetchpriority="high" />
    {%- elsif section.settings.fallback_url != blank -%}
      <img src="{{ section.settings.fallback_url }}" alt="" width="1920" height="1080" fetchpriority="high" />
    {%- endif -%}
  </div>
  <div class="st-hero__shade"></div>
  <div class="st-hero__content{% if section.settings.align == 'center' %} st-hero__content--center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<p class="st-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="st-hero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="st-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="st-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="st-btn st-btn--invert" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="st-btn st-btn--ghost" style="color:#fff;border-color:#fff" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "header", "content": "Background media" },
    { "type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted video. Autoplays muted and loops. Takes priority over everything below." },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "External video, used when no Shopify video is picked." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown when there is no video; also used as the video poster." },
    { "type": "text", "id": "fallback_url", "label": "Fallback image URL", "info": "Used when nothing above is set.", "default": "https://100producedit-png.github.io/WRIST-WATCH-CLUB-WEBSITE/site/assets/frames/orbit/frame_0001.jpg" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW FOR 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Time. Well spent." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Team-designed watches built to take a beating and keep perfect time doing it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop watches" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Explore the Eclipse" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "select", "id": "height", "label": "Height", "default": "full",
      "options": [ { "value": "full", "label": "Full screen" }, { "value": "short", "label": "Short" } ] },
    { "type": "select", "id": "align", "label": "Text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
