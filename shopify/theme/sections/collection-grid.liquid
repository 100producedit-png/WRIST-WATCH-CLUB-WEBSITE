{% assign col = collections[section.settings.collection] %}
<div class="wwc-section-pad">
  <div class="wwc-center">
    <p class="wwc-overline">{{ section.settings.overline }}</p>
    <h2 class="wwc-title">{{ section.settings.heading }}</h2>
  </div>
  <div class="wwc-grid">
    {% if col %}
      {% for product in col.products limit: section.settings.limit %}
        <a class="wwc-card" href="{{ product.url }}">
          <div class="wwc-card__media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.featured_image.alt | escape }}" width="720" height="720" loading="lazy" />
            {% endif %}
          </div>
          <div class="wwc-card__title">{{ product.title }}</div>
          <div class="wwc-card__price">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    {% else %}
      <p class="wwc-prose">Choose a collection for this section in the theme editor.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
    { "type": "text", "id": "overline", "label": "Overline", "default": "WRIST WATCH CLUB" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "default": 4 }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}
