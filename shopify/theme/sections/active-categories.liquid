{{ 'active.css' | asset_url | stylesheet_tag }}
<script src="{{ 'active.js' | asset_url }}" defer></script>

<section class="a-section a-cats">
  <div class="a-wrap">
    {%- if section.settings.kicker != blank -%}<p class="a-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="a-h a-shelf__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <div class="a-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign label = block.settings.label
          if label == blank and col != blank
            assign label = col.title
          endif
          assign url = block.settings.link
          if url == blank and col != blank
            assign url = col.url
          endif
          assign img = block.settings.image
          if img == blank and col != blank
            if col.image
              assign img = col.image
            elsif col.products.first.featured_image
              assign img = col.products.first.featured_image
            endif
          endif
        -%}
        <a class="a-cat" href="{{ url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if img -%}
            {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 100vw, 25vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="a-cat__label">{{ label | default: 'Shop' | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Active — Category tiles",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FIND YOURS" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "label", "label": "Label override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    { "name": "Active — Category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
