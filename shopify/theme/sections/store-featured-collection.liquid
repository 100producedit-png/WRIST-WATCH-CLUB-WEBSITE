{%- comment -%}
  Product carousel ("Bestsellers", "New arrivals", ...).

  Two ways to fill it:
  1. Pick a collection — products render automatically.
  2. Add "Product" blocks — each block hand-picks a product and can OVERRIDE
     its image (picked image or external URL) and hover image. Blocks win
     over the collection when any exist.

  Cards swap to a hover image and show a sale badge, nixon.com-style.
{%- endcomment -%}

{%- assign col = collections[section.settings.collection] -%}

<section class="st-section" data-carousel>
  <div class="st-wrap">
    <div class="st-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="st-h2">{{ section.settings.heading }}</h2>
      </div>
      <div style="display:flex;align-items:center;gap:1.4rem">
        {%- if col -%}<a class="st-all" href="{{ col.url }}">{{ section.settings.view_all_label }}</a>{%- endif -%}
        <div class="st-carousel__nav">
          <button class="st-carousel__btn" type="button" data-carousel-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button class="st-carousel__btn" type="button" data-carousel-next aria-label="Next products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="st-carousel">
      <ul class="st-carousel__track">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign bp = block.settings.product -%}
            {%- assign card_url = block.settings.link -%}
            {%- if card_url == blank and bp -%}{%- assign card_url = bp.url -%}{%- endif -%}
            {%- assign card_title = block.settings.title -%}
            {%- if card_title == blank and bp -%}{%- assign card_title = bp.title -%}{%- endif -%}
            <li {{ block.shopify_attributes }}>
              <a class="st-product-card" href="{{ card_url | default: routes.all_products_collection_url }}">
                <div class="st-product-card__media">
                  {%- if block.settings.image -%}
                    <img class="main" src="{{ block.settings.image | image_url: width: 720 }}" alt="{{ card_title | escape }}" width="720" height="720" loading="lazy" />
                  {%- elsif block.settings.image_url != blank -%}
                    <img class="main" src="{{ block.settings.image_url }}" alt="{{ card_title | escape }}" width="720" height="720" loading="lazy" />
                  {%- elsif bp.featured_image -%}
                    <img class="main" src="{{ bp.featured_image | image_url: width: 720 }}" alt="{{ bp.featured_image.alt | escape }}" width="720" height="720" loading="lazy" />
                  {%- endif -%}
                  {%- if block.settings.hover_image -%}
                    <img class="alt" src="{{ block.settings.hover_image | image_url: width: 720 }}" alt="" width="720" height="720" loading="lazy" aria-hidden="true" />
                  {%- elsif block.settings.image == null and block.settings.image_url == blank and bp.images[1] -%}
                    <img class="alt" src="{{ bp.images[1] | image_url: width: 720 }}" alt="" width="720" height="720" loading="lazy" aria-hidden="true" />
                  {%- endif -%}
                  {%- if bp and bp.compare_at_price > bp.price -%}
                    <span class="st-badge">Sale</span>
                  {%- endif -%}
                </div>
                <p class="st-product-card__title">{{ card_title | default: 'Pick a product' }}</p>
                <p class="st-product-card__price">
                  {%- if bp -%}
                    {%- if bp.compare_at_price > bp.price -%}
                      <span class="sale">{{ bp.price | money }}</span><s>{{ bp.compare_at_price | money }}</s>
                    {%- else -%}
                      {{ bp.price | money }}
                    {%- endif -%}
                  {%- else -%}
                    {{ block.settings.price_text }}
                  {%- endif -%}
                </p>
              </a>
            </li>
          {%- endfor -%}
        {%- elsif col and col.products.size > 0 -%}
          {%- for product in col.products limit: section.settings.limit -%}
            <li>
              <a class="st-product-card" href="{{ product.url }}">
                <div class="st-product-card__media">
                  {%- if product.featured_image -%}
                    <img class="main" src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.featured_image.alt | escape }}" width="720" height="720" loading="lazy" />
                    {%- if product.images[1] -%}
                      <img class="alt" src="{{ product.images[1] | image_url: width: 720 }}" alt="" width="720" height="720" loading="lazy" aria-hidden="true" />
                    {%- endif -%}
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="st-badge">Sale</span>
                  {%- endif -%}
                </div>
                <p class="st-product-card__title">{{ product.title }}</p>
                <p class="st-product-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="sale">{{ product.price | money }}</span><s>{{ product.compare_at_price | money }}</s>
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </p>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>
              <div class="st-product-card">
                <div class="st-product-card__media"></div>
                <p class="st-product-card__title">Pick a collection</p>
                <p class="st-product-card__price">Or add product blocks</p>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when no Product blocks are added. Blocks always win." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MOST WANTED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "Shop all" },
    { "type": "range", "id": "limit", "label": "Products to show (collection mode)", "min": 4, "max": 16, "default": 8 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 16,
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Title, price, link and sale badge come from this product." },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Replaces the product's featured image on the card." },
        { "type": "text", "id": "image_url", "label": "Image override URL", "info": "External image, used when no image is picked above." },
        { "type": "image_picker", "id": "hover_image", "label": "Hover image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "price_text", "label": "Price text (no product picked)" }
      ]
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
