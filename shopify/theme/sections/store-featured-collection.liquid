{%- comment -%}
  Product carousel for a collection ("Bestsellers", "New arrivals", ...).
  Horizontal scroll-snap with arrow buttons; cards swap to the second product
  image on hover and show a sale badge, nixon.com-style.
{%- endcomment -%}

{%- assign col = collections[section.settings.collection] -%}

<section class="st-section" data-carousel>
  <div class="st-wrap">
    <div class="st-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="st-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="st-h2">{{ section.settings.heading }}</h2>
      </div>
      <div style="display:flex;align-items:center;gap:1.4rem">
        {%- if col -%}<a class="st-all" href="{{ col.url }}">{{ section.settings.view_all_label }}</a>{%- endif -%}
        <div class="st-carousel__nav">
          <button class="st-carousel__btn" type="button" data-carousel-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button class="st-carousel__btn" type="button" data-carousel-next aria-label="Next products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="st-carousel">
      <ul class="st-carousel__track">
        {%- if col and col.products.size > 0 -%}
          {%- for product in col.products limit: section.settings.limit -%}
            <li>
              <a class="st-product-card" href="{{ product.url }}">
                <div class="st-product-card__media">
                  {%- if product.featured_image -%}
                    <img class="main" src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.featured_image.alt | escape }}" width="720" height="720" loading="lazy" />
                    {%- if product.images[1] -%}
                      <img class="alt" src="{{ product.images[1] | image_url: width: 720 }}" alt="" width="720" height="720" loading="lazy" aria-hidden="true" />
                    {%- endif -%}
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="st-badge">Sale</span>
                  {%- endif -%}
                </div>
                <p class="st-product-card__title">{{ product.title }}</p>
                <p class="st-product-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="sale">{{ product.price | money }}</span><s>{{ product.compare_at_price | money }}</s>
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </p>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>
              <div class="st-product-card">
                <div class="st-product-card__media"></div>
                <p class="st-product-card__title">Pick a collection</p>
                <p class="st-product-card__price">In the theme editor</p>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MOST WANTED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "Shop all" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 16, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
