{{ 'active.css' | asset_url | stylesheet_tag }}
<script src="{{ 'active.js' | asset_url }}" defer></script>

<div class="a-annc">
  <div class="a-annc__inner">
    {%- for block in section.blocks -%}
      <p class="a-annc__msg" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </p>
    {%- endfor -%}
    {%- if section.blocks.size == 0 -%}
      <p class="a-annc__msg is-on">Free shipping on orders over $50</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Active — Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Active — Announcement bar",
      "blocks": [
        { "type": "message" },
        { "type": "message", "settings": { "text": "New arrivals just dropped — shop the latest" } },
        { "type": "message", "settings": { "text": "2-year warranty on every watch" } }
      ]
    }
  ]
}
{% endschema %}
