{%- comment -%}
  Storefront header: rotating announcement bar + sticky nav with mega menu.
  The mega menu is driven entirely by the menu picked in the theme editor —
  top-level links become nav items, their child links become dropdown columns,
  grandchild links become the column entries (nixon.com-style).
{%- endcomment -%}

{%- assign menu = section.settings.menu -%}

{%- if section.blocks.size > 0 -%}
  <div class="st-announce" data-announce>
    <div class="st-announce__track">
      {%- for block in section.blocks -%}
        <p class="st-announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<header class="st-header">
  <div class="st-header__bar">
    <button class="st-icon-btn st-burger" type="button" data-drawer-open="StoreDrawer" aria-expanded="false" aria-label="Open menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a class="st-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" height="34" />
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    {%- if linklists[menu].links.size > 0 -%}
      <ul class="st-nav">
        {%- for link in linklists[menu].links -%}
          <li class="st-nav__item">
            <a class="st-nav__link" href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <div class="st-mega">
                <div class="st-mega__inner">
                  {%- for child in link.links -%}
                    <div class="st-mega__col">
                      <a class="st-mega__head" href="{{ child.url }}">{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul>
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="st-header__icons">
      <a class="st-icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="st-icon-btn" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5"/></svg>
        </a>
      {%- endif -%}
      <a class="st-icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
        {%- if cart.item_count > 0 -%}<span class="st-cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>

<div class="st-drawer" id="StoreDrawer">
  <div class="st-drawer__scrim" data-drawer-close></div>
  <div class="st-drawer__panel">
    <div class="st-drawer__close">
      <button class="st-icon-btn" type="button" data-drawer-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
    </div>
    <nav aria-label="Mobile navigation">
      <ul>
        {%- for link in linklists[menu].links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary class="st-drawer__top">{{ link.title }}</summary>
                <ul>
                  <li><a href="{{ link.url }}">Shop all {{ link.title | downcase }}</a></li>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- for grandchild in child.links -%}
                      <li><a href="{{ grandchild.url }}">&nbsp;&nbsp;{{ grandchild.title }}</a></li>
                    {%- endfor -%}
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="st-drawer__top" href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="st-drawer__meta">
      <a href="{{ routes.search_url }}">Search</a>
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Account</a>{%- endif -%}
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "wwc-store-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Leave empty to use the store name as a logotype." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Nested links become mega-menu columns." }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "FREE SHIPPING ON ORDERS OVER $50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FREE SHIPPING ON ORDERS OVER $50" } },
        { "type": "announcement", "settings": { "text": "2-YEAR WARRANTY ON EVERY WATCH" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
