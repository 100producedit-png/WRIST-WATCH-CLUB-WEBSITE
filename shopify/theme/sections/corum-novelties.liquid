{{ 'corum.css' | asset_url | stylesheet_tag }}
<script src="{{ 'corum.js' | asset_url }}" defer></script>

{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.max_products
-%}

<section class="m-section m-novel" data-carousel>
  <div class="m-novel__head">
    <div>
      {%- if section.settings.overline != blank -%}
        <p class="m-overline" data-reveal>{{ section.settings.overline | escape }}</p>
      {%- endif -%}
      <h2 class="m-display m-novel__title" data-reveal data-reveal-delay="100">{{ section.settings.title }}</h2>
    </div>
    <div class="m-novel__nav" data-reveal data-reveal-delay="200">
      <button class="m-novel__btn" type="button" data-carousel-prev aria-label="Previous">←</button>
      <button class="m-novel__btn" type="button" data-carousel-next aria-label="Next">→</button>
    </div>
  </div>

  <div class="m-track" data-reveal data-reveal-delay="150">
    {%- if col != blank and col.products.size > 0 -%}
      {%- for product in col.products limit: limit -%}
        <a class="m-card" href="{{ product.url }}">
          <div class="m-card__media">
            {%- if section.settings.badge != blank and forloop.first -%}
              <span class="m-card__tag">{{ section.settings.badge | escape }}</span>
            {%- endif -%}
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 860px) 74vw, 344px' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <h3 class="m-card__title">{{ product.title | escape }}</h3>
          {%- if product.type != blank -%}<p class="m-card__meta">{{ product.type | escape }}</p>{%- endif -%}
          <p class="m-card__price">
            {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
          </p>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <a class="m-card" href="{{ routes.all_products_collection_url }}">
          <div class="m-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <h3 class="m-card__title">Timepiece {{ i }}</h3>
          <p class="m-card__meta">Select a collection in the theme editor</p>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="m-progress" aria-hidden="true"><span></span></div>
</section>

{% schema %}
{
  "name": "Maison — Novelties",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "NEW THIS SEASON" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "The <em>novelties</em>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "badge", "label": "Badge on first product", "default": "New" }
  ],
  "presets": [{ "name": "Maison — Novelties" }]
}
{% endschema %}
