{% comment %}
  WRIST WATCH CLUB — Eclipse (cinematic scroll page)

  HOW THIS WORKS
  The heavy assets (403 scrub frames, fonts, CSS, JS) stay on a static host;
  this template only carries the markup. Set `wwc_base` below to the public
  URL of this repo's `site/` folder — with GitHub Pages enabled on the repo
  it is:  https://100producedit-png.github.io/WRIST-WATCH-CLUB-WEBSITE/site/
  (keep the trailing slash).

  Pair with the `full-bleed` layout (shopify/layout/full-bleed.liquid) so the
  theme's own header/footer don't wrap the experience.

  The markup below mirrors site/index.html — that file is the source of
  truth; if you change one, change the other.
{% endcomment %}

{% layout 'full-bleed' %}
{% assign wwc_base = 'https://100producedit-png.github.io/WRIST-WATCH-CLUB-WEBSITE/site/' %}

<link rel="stylesheet" href="{{ wwc_base }}css/style.css" />
<script>
  window.WWC_ASSET_BASE = '{{ wwc_base }}';
  document.body.classList.add('is-loading');
</script>

<!-- ═ Preloader ═ -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__mark">
    <svg viewBox="0 0 64 64" width="56" height="56" aria-hidden="true">
      <circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" stroke-width="1" opacity=".35"/>
      <path d="M32 6a26 26 0 0 0 0 52 21 21 0 0 1 0-52z" fill="currentColor"/>
    </svg>
  </div>
  <div class="loader__wordmark">WRIST WATCH CLUB</div>
  <div class="loader__bar"><span id="loaderBar"></span></div>
  <div class="loader__pct" id="loaderPct">0</div>
</div>

<!-- ═ Fixed chrome ═ -->
<header class="chrome" id="chrome">
  <div class="chrome__brand">WRIST WATCH CLUB</div>
  <div class="chrome__right">
    <span class="chrome__edition">ECLIPSE — EDITION OF 88</span>
    <a class="chrome__cta" href="#waitlist" data-scrollto>Enquire</a>
  </div>
</header>

<main id="main">

  <!-- ═ 01 · HERO ORBIT ═ -->
  <section class="seq-section" id="hero" data-seq="orbit">
    <div class="seq-sticky">
      <canvas class="seq-canvas" id="canvasOrbit" aria-label="The Eclipse watch, rotating"></canvas>
      <div class="vignette"></div>

      <div class="hero-stage hero-stage--brand" id="heroBrand">
        <p class="overline">MAISON D'HORLOGERIE — GENÈVE</p>
        <h1 class="hero-title" id="heroTitle" aria-label="WRIST WATCH CLUB">
          <span class="hero-title__line" data-track>Wrist Watch Club</span>
        </h1>
        <p class="hero-sub">presents</p>
      </div>

      <div class="hero-stage hero-stage--name" id="heroName" aria-hidden="true">
        <p class="overline overline--gold">TOURBILLON CHRONOGRAPH</p>
        <h2 class="eclipse-title">Eclipse</h2>
        <p class="hero-sub hero-sub--wide">Light, withheld.</p>
      </div>

      <div class="scroll-cue" id="scrollCue">
        <span>SCROLL</span>
        <i></i>
      </div>
    </div>
  </section>

  <!-- ═ 02 · STORY ═ -->
  <section class="story" id="story">
    <div class="story-sticky">
      <div class="story__inner">
        <p class="overline overline--gold story-el">CHAPTER I</p>
        <h2 class="story__title">
          <span class="story-line"><span>Crafted</span></span>
          <span class="story-line"><span>in&nbsp;Darkness.</span></span>
        </h2>
        <div class="story__body">
          <p class="story-el">Eight years in a blackened atelier above Lac Léman.</p>
          <p class="story-el">One movement. No compromise.</p>
          <p class="story-el story-el--gold">The rest is silence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═ 03 · MACRO ═ -->
  <section class="seq-section" id="macro" data-seq="macro">
    <div class="seq-sticky">
      <canvas class="seq-canvas" id="canvasMacro" aria-label="Macro detail of the Eclipse dial"></canvas>
      <div class="vignette"></div>

      <div class="macro-caption" data-caption="0">
        <p class="overline overline--gold">CHAPTER II — THE SURFACE</p>
        <p class="macro-caption__text">Indices engraved by one hand.<br/>The same hand, for every piece.</p>
      </div>
      <div class="macro-caption" data-caption="1">
        <p class="overline overline--gold">THE HEART</p>
        <p class="macro-caption__text">A gold tourbillon, breathing<br/>at 21,600 beats per hour.</p>
      </div>
      <div class="macro-caption" data-caption="2">
        <p class="overline overline--gold">THE FINISH</p>
        <p class="macro-caption__text">Titanium, brushed until<br/>it forgets it is metal.</p>
      </div>
    </div>
  </section>

  <!-- ═ 04 · ENGINEERING / EXPLODED ═ -->
  <section class="seq-section seq-section--tall" id="engineering" data-seq="assembly">
    <div class="seq-sticky">
      <canvas class="seq-canvas" id="canvasAssembly" aria-label="The Eclipse assembling from its components"></canvas>
      <div class="vignette"></div>

      <div class="eng-header">
        <p class="overline overline--gold">CHAPTER III — THE ASSEMBLY</p>
      </div>

      <div class="spec" data-spec="0">
        <div class="spec__rule"></div>
        <div class="spec__num">42<span> mm</span></div>
        <div class="spec__label">GRADE-5 TITANIUM CASE</div>
      </div>
      <div class="spec spec--right" data-spec="1">
        <div class="spec__rule"></div>
        <div class="spec__num">72<span> h</span></div>
        <div class="spec__label">POWER RESERVE</div>
      </div>
      <div class="spec" data-spec="2">
        <div class="spec__rule"></div>
        <div class="spec__num">217</div>
        <div class="spec__label">COMPONENTS, PLACED BY HAND</div>
      </div>
    </div>
  </section>

  <!-- ═ 05 · EDITION ═ -->
  <section class="edition" id="edition">
    <div class="edition__inner">
      <p class="overline overline--gold edition-el">THE ALLOCATION</p>
      <h2 class="edition__title edition-el">Edition <em>of</em> 88</h2>
      <div class="edition__rule edition-el"></div>
      <p class="edition__price edition-el">$48,000</p>
      <p class="edition__note edition-el">Numbered. Never repeated.</p>
    </div>
  </section>

  <!-- ═ 06 · WAITLIST ═ -->
  <section class="waitlist" id="waitlist">
    <div class="waitlist__inner">
      <p class="overline overline--gold wl-el">PRIVATE WAITLIST</p>
      <h2 class="waitlist__title wl-el">Few will be asked.</h2>
      <form class="waitlist__form wl-el" id="waitlistForm" novalidate>
        <input type="email" id="wlEmail" name="email" placeholder="Your email" autocomplete="email" required aria-label="Email address" />
        <button type="submit"><span>Request allocation</span></button>
      </form>
      <p class="waitlist__confirm" id="wlConfirm" aria-live="polite">Noted. If a piece becomes yours, we will write.</p>
      <p class="waitlist__small wl-el">Discretion assured. One enquiry per collector.</p>
    </div>

    <footer class="footer">
      <div class="footer__brand">WRIST WATCH CLUB</div>
      <div class="footer__meta">
        <span>GENÈVE · MMXXVI</span>
        <span>ECLIPSE — TOURBILLON CHRONOGRAPH</span>
      </div>
      <div class="footer__legal">A fictional maison, imagined for the love of the craft.</div>
    </footer>
  </section>

</main>

<div class="grain" aria-hidden="true"></div>

<script src="{{ wwc_base }}js/vendor/lenis.min.js"></script>
<script src="{{ wwc_base }}js/vendor/gsap.min.js"></script>
<script src="{{ wwc_base }}js/vendor/ScrollTrigger.min.js"></script>
<script src="{{ wwc_base }}js/main.js"></script>
